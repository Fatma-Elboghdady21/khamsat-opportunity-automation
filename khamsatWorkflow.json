    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst titles = data.title || [];\nconst urls = data.url || [];\nconst dates = data.createdAt || [];\n\nconst posts = titles.map((title, index) => {\n  const url = String(urls[index] || '');\n  const match = url.match(/\\/requests\\/(\\d+)-/);\n\n  return {\n    request_id: match ? match[1] : null,\n    title: title,\n    url: url.startsWith('http')\n      ? url\n      : `https://khamsat.com${url}`,\n    createdAt: dates[index] || ''\n  };\n});\n\nfunction parseDate(dateString) {\n  const match = String(dateString).match(\n    /(\\d{2})\\/(\\d{2})\\/(\\d{4})\\s+(\\d{2}):(\\d{2}):(\\d{2})/\n  );\n\n  if (!match) return 0;\n\n  const [, day, month, year, hour, minute, second] = match;\n\n  return Date.UTC(\n    Number(year),\n    Number(month) - 1,\n    Number(day),\n    Number(hour),\n    Number(minute),\n    Number(second)\n  );\n}\n\nposts.sort((a, b) => {\n  return parseDate(b.createdAt) - parseDate(a.createdAt);\n});\n\nreturn posts.map(post => ({\n  json: post\n}));"
      },
